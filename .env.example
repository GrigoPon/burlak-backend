# ============================================
# Переменные окружения для BOM System
# ============================================

# Redis (брокер Celery)
REDIS_URL=redis://redis:6379/0

# База данных (SQLite)
# Для локальной разработки можно использовать sqlite:///./dev.db
# В Docker используется /data/jobs.db
DB_URL=/data/jobs.db

# Хранилище файлов
STORAGE_PATH=/data

# ML Сервис
ML_SERVICE_URL=http://ml-mock:5000

# Настройки загрузки
CHUNK_SIZE_BYTES=20971520

# Backend порт
BACKEND_PORT=8000
